; Copy this file into ~/.openclaw/localclaw/.config/supervisor/conf.d/
; and adjust repo paths / command flags for your setup.

[program:git-ai-sync-vault]
command=/home/openclaw/.local/bin/git-ai-sync watch /home/openclaw/vault --interval 30
directory=/home/openclaw/vault
autostart=true
autorestart=true
priority=30
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
stderr_logfile=/dev/fd/2
stderr_logfile_maxbytes=0
